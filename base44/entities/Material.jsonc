{
  "name": "Material",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Material name"
    },
    "types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Types or variations of this material"
    },
    "description": {
      "type": "string",
      "description": "Description of the material"
    },
    "image_url": {
      "type": "string",
      "description": "Image representing this material"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Order in display"
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "description": "Show on capabilities page"
    }
  },
  "required": [
    "name",
    "description"
  ]
}